# Public URL of the Flask API on Render. Committed on purpose (see the
# !frontend/.env.production exception in .gitignore): it holds no secret,
# and the Pages build bakes it into the bundle at build time.
VITE_API_BASE_URL=https://wildlife-conservation-tracker.onrender.com

# CARTO basemap key. Committed deliberately, like the API URL above: a
# client-side tile key is unavoidably visible in the bundle, since the browser
# itself must send it to CARTO. Restrict it by domain in the CARTO dashboard --
# that, not secrecy, is what stops someone else spending your tile quota.
VITE_CARTO_API_KEY=cb1_4mww_1_7b0064e74998dcfcd74896b1
