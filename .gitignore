# Wildlife Conservation Tracker — root .gitignore
#
# This file holds only rules that are genuinely global to the repository.
# Language-specific rules live next to the code they apply to:
#
#   backend/.gitignore   Python, Flask, venv, model artifacts
#   frontend/.gitignore  Node, Vite, build output, env files
#
# Keep it that way. This file previously concatenated a Python and a Node
# template, and because Python's packaging patterns are unanchored they
# matched at any depth — "lib/" silently excluded frontend/src/lib/, "*.pkl"
# excluded the trained model, and "package-lock.json" broke `npm ci`. Each one
# cost a failed deploy, and none of them failed locally, because ignored files
# still exist on disk. Test frontend changes from a clean clone.

# ============================================================================
# SECRETS & ENVIRONMENT
# ============================================================================

.env
.env.local
.env.development
.env.test
.env.production

# frontend/.env.production is re-included by frontend/.gitignore: it holds only
# the public API URL and the Pages build needs it.

*_credentials.json
secrets.py
iucn_token.txt
api_token.txt

# Neon CLI project link (org/project/branch ids, written by `neon link`)
.neon

# ============================================================================
# DEPENDENCIES (root-level only; see frontend/ and backend/ for theirs)
# ============================================================================

node_modules/

# ============================================================================
# TOOLING & EDITORS
# ============================================================================

.claude
.vscode/
.history/
.idea/
*.iml
*.iws
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
\#*\#
.\#*
.ipynb_checkpoints

# ============================================================================
# OPERATING SYSTEM
# ============================================================================

.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.directory
.Trash-*

# ============================================================================
# LOGS & TEMPORARY FILES
# ============================================================================

*.log
logs/
tmp/
temp/
*.tmp
*.bak
.cache/
*.cache

# ============================================================================
# BACKUPS & ARCHIVES
# ============================================================================

backups/
*.backup
*.7z
*.dmg
*.gz
*.iso
*.rar
*.tar
*.zip
