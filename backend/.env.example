# Wildlife Conservation Tracker - Environment Variables (template)
# Copy this file to .env and fill in your real values:
#   cp .env.example .env

# IUCN Red List API v4 token — request one at https://api.iucnredlist.org/
IUCN_API_TOKEN=your_iucn_v4_token_here

# Flask secret key — use a long random string in production
SECRET_KEY=change-me

# Database connection
DATABASE_URL=postgresql://localhost/wildlife_tracker
